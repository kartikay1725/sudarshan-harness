{
  "name": "sudarshan-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sudarshan Harness \u2014 a local-first, model-agnostic control and verification layer for AI agents.",
  "workspaces": [
    "packages/core",
    "packages/adapters",
    "packages/capabilities",
    "packages/spec",
    "packages/runtime",
    "apps/server",
    "apps/cli",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev --workspace @sudarshan/server",
    "dev:web": "npm run dev --workspace @sudarshan/web",
    "build:web": "npm run build --workspace @sudarshan/web",
    "ide": "npm run build:web && npm run start",
    "ide:playground": "npm run build:web && SUDARSHAN_WORKSPACE=./playground npm run start",
    "cli": "npm run cli --workspace @sudarshan/cli --",
    "start": "npm run start --workspace @sudarshan/server",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
