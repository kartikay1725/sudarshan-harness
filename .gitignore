# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.user

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.production

# Frontend build artifacts (tracked separately under frontend/)
frontend/.next/
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Dependencies
node_modules/

# Build artifacts (regenerate with npm run build:web / apps/desktop bundle)
dist/
apps/web/dist/
apps/desktop/dist/
apps/desktop/release/
*.tsbuildinfo

# Harness state produced by runs (audit trails, scratch): inspect, don't commit
.sudarshan/
playground/.sudarshan/audit/

# Desktop shell local state
apps/desktop/*.json.bak
