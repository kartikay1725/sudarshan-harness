# Copy to .env.local and fill in. Never commit real credentials.
#
# MongoDB connection string for the pre-registration waitlist.
MONGODB_URI=mongodb://localhost:27017
# Explicit database name. Leaving it unset defaults to "sudarshan".
MONGODB_DB=sudarshan

# Best-effort, per-instance request brake for /api/pre-register.
# This is NOT a security boundary on serverless: put a real rate limiter
# (Vercel WAF, Upstash) in front of the function. Set 0 to disable.
RATE_LIMIT_PER_IP_MAX=10
RATE_LIMIT_WINDOW_MS=300000
